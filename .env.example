# Next.js: select your own Convex deployment with npx convex dev.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Set these in the Convex deployment dashboard, NOT as NEXT_PUBLIC variables:
# SITE_URL=http://localhost:3000
# JWT_PRIVATE_KEY — generated during Convex Auth setup
# JWKS — generated during Convex Auth setup
# AUTH_RESEND_KEY=<your Resend API key>
# AUTH_EMAIL_FROM=SmartChama <onboarding@resend.dev>
